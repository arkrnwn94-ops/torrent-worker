{
  "name": "torrent-worker",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": { "version": "latest" }
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "worker", "visibility": "public" }
  }
}
